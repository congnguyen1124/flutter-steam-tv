# See https://docs.tizen.org/application/tizen-studio/native-tools/project-conversion
# for details.

APPNAME = video_player_tizen_plugin
type = sharedLib
profile = common-5.5

# PlusPlayer is distributed only for ARM Samsung TVs. On emulator architectures, build a tiny
# registrar so the application can launch and exercise its non-playback UI. The Dart controller
# receives a channel error when playback is attempted, which stream_player turns into its normal
# error state. A real TV build keeps the complete upstream implementation below.
ifneq ($(BUILD_ARCH),armel)
USER_SRCS += src/video_player_tizen_plugin_stub.cc
else
USER_SRCS += src/device_proxy.cc
USER_SRCS += src/drm_license_helper.cc
USER_SRCS += src/drm_manager.cc
USER_SRCS += src/drm_manager_proxy.cc
USER_SRCS += src/ecore_wl2_window_proxy.cc
USER_SRCS += src/media_player.cc
USER_SRCS += src/media_player_proxy.cc
USER_SRCS += src/messages.cc
USER_SRCS += src/plus_player.cc
USER_SRCS += src/video_player.cc
USER_SRCS += src/video_player_tizen_plugin.cc
endif

# User defines
USER_DEFS =
USER_UNDEFS =
USER_CPP_DEFS = FLUTTER_PLUGIN_IMPL
USER_CPP_UNDEFS =

# Compiler flags
USER_CFLAGS_MISC =
USER_CPPFLAGS_MISC =

# User includes
USER_INC_DIRS = inc src inc/plusplayer
USER_INC_FILES =
USER_CPP_INC_FILES =

# Linker options
ifeq ($(BUILD_ARCH),armel)
USER_LIB_DIRS = lib/${BUILD_ARCH}/${API_VERSION}
endif
USER_LFLAGS = -Wl,-rpath='$$ORIGIN'
USER_LIBS = stdc++
ifeq ($(BUILD_ARCH),armel)
USER_LIBS += plusplayer-wrapper gstsubtitle_tvplus gstsubtitleparse_tvplus plusplayercore_tvplus tracksource_tvplus plusplayer_tvplus dashplusplayer_tvplus
endif
